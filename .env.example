# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Generate a signing key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# REQUIRED in production. Signs login tokens; an empty value means anyone can
# forge a session for any user. Leave unset only for local DEBUG runs, where a
# random secret is generated and cached in backend/data/.jwt_secret.
JWT_SECRET=

# OpenClaw Gateway. Runs on the same VPS, so localhost is correct in production.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main

# WhatsApp destination for proactive briefings.
# E.164 without the plus sign (628123456789), or a group JID (...@g.us).
NOTIFY_WHATSAPP_TO=

# Model provider, used as a fallback when the gateway is unreachable.
NINE_ROUTER_BASE_URL=https://9router.jcamp.io/v1
NINE_ROUTER_API_KEY=

# Set false in production so a missing JWT_SECRET fails loudly at startup.
DEBUG=true
